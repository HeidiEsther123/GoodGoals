@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Correo enviado";
}

<h1>@ViewData["Title"]</h1>
<p>
    Si el correo ingresado está registrado, recibirás las instrucciones
    para restablecer tu contraseña.
</p>
<a asp-page="./Login" class="btn btn-primary">Volver al inicio de sesión</a>
