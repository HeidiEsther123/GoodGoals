@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "¿Olvidaste tu contraseña?";
}

<h1>¿Olvidaste tu contraseña?</h1>
<h2>Ingresa tu correo y te mostraremos el link para restablecerla.</h2>
<hr />
<div class="row justify-content-center">
    <div class="col-md-5">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username"
                       aria-required="true" placeholder="correo@ejemplo.com" />
                <label asp-for="Input.Email" class="form-label">Correo electrónico</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">Restablecer contraseña</button>
        </form>

        @if (Model.ResetLink != null)
        {
            <div class="mt-4 p-3" style="background:rgba(174,255,128,0.1); border:1px solid #AEFF80; border-radius:8px;">
                <p style="color:#AEFF80; font-weight:600;"> Link para restablecer tu contraseña:</p>
                <a href="@Model.ResetLink" class="btn btn-primary mt-2">
                    Haz clic aquí para restablecer tu contraseña
                </a>
                <p class="mt-2 text-muted small">
                    (En producción este link llegaría por correo)
                </p>
            </div>
        }

        <div class="mt-3">
            <a asp-page="./Login">Volver al inicio de sesión</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

