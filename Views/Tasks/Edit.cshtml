@model TaskItem
@{ ViewData["Title"] = "Editar Tarea"; }

<h2>Editar Tarea</h2>
<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="GoalId" class="form-label">Meta (opcional)</label>
        <select asp-for="GoalId" class="form-select">
            <option value="">-- Ninguna --</option>
            @foreach (var g in (IEnumerable<Goal>)ViewBag.Goals)
            {
                <option value="@g.Id">@g.Title</option>
            }
        </select>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsCompleted" class="form-check-input" />
        <label asp-for="IsCompleted" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
