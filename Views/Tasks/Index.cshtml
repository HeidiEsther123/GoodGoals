@model IEnumerable<TaskItem>
@{ ViewData["Title"] = "Mis Tareas"; }

<h2>📝 Mis Tareas</h2>
<a class="btn btn-success mb-3" asp-action="Create">+ Nueva Tarea</a>

<table class="table table-striped">
    <thead><tr><th>Título</th><th>Vence</th><th>Meta</th><th>Estado</th><th></th></tr></thead>
    <tbody>
    @foreach (var task in Model)
    {
        <tr>
            <td>@task.Title</td>
            <td>@(task.DueDate?.ToShortDateString() ?? "-")</td>
            <td>@(task.Goal?.Title ?? "-")</td>
            <td>@(task.IsCompleted ? "✅ Completada" : "⏳ Pendiente")</td>
            <td class="d-flex gap-1">
                <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@task.Id">Editar</a>
                <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@task.Id">Eliminar</a>
                <form asp-action="ToggleCompleted" asp-route-id="@task.Id" method="post">
                    <button type="submit" class="btn btn-sm btn-outline-success">@(task.IsCompleted ? "Reabrir" : "Completar")</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
