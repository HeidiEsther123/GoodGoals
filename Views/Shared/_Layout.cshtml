<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Good Goals</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>

    <!-- Esferas animadas de fondo -->
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>
    <i class="bubble"></i>

    <header>
        <nav class="navbar navbar-expand-sm navbar-dark mb-3">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">🎯 Good Goals</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" asp-controller="Goals" asp-action="Index">Metas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Tasks" asp-action="Index">Tareas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Notes" asp-action="Index">Notas</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Reminders" asp-action="Index">Recordatorios</a></li>
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <!-- NUEVO CONTENEDOR FLEX: Empuja el footer hacia abajo -->
    <div class="content-stretch">
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    </div>

    <footer class="border-top footer text-center py-3 mt-4">
        <div class="container">&copy; 2026 - Good Goals - Heidi Esther Peña Betanzos</div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>