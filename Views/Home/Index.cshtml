@{
    ViewData["Title"] = "Inicio";
}

<div class="text-center py-5">
    <h1 class="display-5">Bienvenido Good Goals </h1>
    <p class="lead">Bienvenido!! Organiza tus metas, tareas, notas y recordatorios en un solo lugar.</p>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <a class="btn btn-primary btn-lg" asp-controller="Goals" asp-action="Index">Ir a mis Metas</a>
    }
    else
    {
        <a class="btn btn-primary btn-lg" asp-area="Identity" asp-page="/Account/Register">Crear cuenta </a>
    }
    <hr class="my-4" />
    
</div>
